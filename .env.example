# 家族の名前。URL のパスにそのまま出るので英数字で。
USERS=taro,hanako,ichiro,jiro

# データの置き場所。compose ファイルからの相対。既定のままでよい。
# DATA_PATH=./data

# `npm run dev` で直接動かすときの保存先。Docker では compose が /data を渡すので不要。
DATA_DIR=./data

# トピックに指定が無いときのエンジン。claude | cursor
# DEFAULT_ENGINE=cursor

# 各エンジンの既定モデル。トピックごとに画面から変えられる。
# CLAUDE_MODEL=claude-opus-5
# CURSOR_MODEL=auto

# 記憶の更新に使う側。書き換えを伴うので権限を絞れる claude が既定。
# SUMMARY_ENGINE=claude
# SUMMARY_MODEL=sonnet

# バインドマウント先を書ける UID/GID に合わせる。
# 確認方法: NAS に SSH して `ls -n /path/to/kokuboke/data`
APP_UID=1000
APP_GID=1000

# ビルド中の cursor-agent の導入で転ぶときは false にして先に進む。
# その場合トピックのエンジンは claude だけになる。
# INSTALL_CURSOR=true
