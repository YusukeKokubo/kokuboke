# 家族の名前。URL のパスにそのまま出るので英数字で。
USERS=taro,hanako,ichiro,jiro

# データの置き場所。NAS では既定のままでよい。手元で試すときは ./data など。
# DATA_PATH=/volume1/docker/kokuboke/data

# `npm run dev` で直接動かすときの保存先。Docker では compose が /data を渡すので不要。
DATA_DIR=./data

# トピックに指定が無いときのエンジン。claude | cursor
# DEFAULT_ENGINE=claude

# 各エンジンの既定モデル。トピックごとに画面から変えられる。
# CLAUDE_MODEL=claude-opus-5
# CURSOR_MODEL=composer-2.5
# SUMMARY_MODEL=sonnet

# NAS 上のバインドマウント先を書ける UID/GID に合わせる。
# 確認方法: NAS に SSH して `ls -n /volume1/docker/kokuboke/data`
APP_UID=1000
APP_GID=1000
