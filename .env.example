# 家族の名前。URL のパスにそのまま出るので英数字で。
USERS=taro,hanako,ichiro,jiro

# `npm run dev` で直接動かすときの保存先。Docker では compose が /data を渡すので不要。
# 本番のデータで試すなら、SMB の先を直接指さずに `npm run data:pull` で写した先を書く。
# CLI は作業ディレクトリを SMB 越しに探ると一文字目まで数十秒かかる。
# リポジトリの外に置く（中だとこのプロジェクトの AGENTS.md が会話に混ざる）。
DATA_DIR=./data

# `npm run data:pull` の写し元。NAS を SMB で開いた先の data フォルダ。
# DATA_DIR へ片方向に写し、手元の変更は次に写したときに消える。
# DATA_PULL_FROM=/Volumes/…/data

# 家族共有スペースのフォルダ名。USERS には入れない。既定は _family。
# FAMILY_DIR=_family

# トピックに指定が無いときのエンジン。claude | cursor
# DEFAULT_ENGINE=cursor

# 各エンジンの既定モデル。トピックごとに画面から変えられる。
# 会話と要約の下書きは、この選択を使う。
# CLAUDE_MODEL=claude-opus-5
# CURSOR_MODEL=auto

# Claude Code の考える深さの既定。low | medium | high | xhigh | max。空なら CLI の既定。
# トピックごとに画面から選べて、選んだ方が勝つ。段の無い Haiku 4.5 には渡さない。
# CLAUDE_EFFORT=

# 自動の命名とタグ付けに使う軽いモデル。エンジンはトピックのものに合わせる。
# CLAUDE_LIGHT_MODEL=claude-haiku-4-5
# CURSOR_LIGHT_MODEL=composer-2.5

# 更新の画面（/admin?key=...）の鍵。空のままだと画面ごと閉じる。
# 誰の画面かは URL でしか分けていないので、家族の URL を知っているだけでは
# 更新を叩けないように、ここは別の鍵にする。
#   openssl rand -hex 24
# ADMIN_TOKEN=

# Watchtower の待ち受けを守る鍵。NAS で立てるときは必須（deploy.sh が確かめる）。
# アプリはこれを添えて「今見に行け」と頼む。
#   openssl rand -hex 24
# WATCHTOWER_TOKEN=

# ここから下は動かす機械ごとの値。アプリの設定ではない。

# データの置き場所。compose ファイルからの相対。既定のままでよい。
# DATA_PATH=./data

# コンテナは UID 1000 で動く。data の所有者がそれと違うとログを書けない。
# 確認方法: `ls -n data`。ずれていたら `sudo chown -R 1000:1000 data`。

# ビルド中の cursor-agent の導入で転ぶときは false にして先に進む。
# その場合トピックのエンジンは claude だけになる。
# INSTALL_CURSOR=true

# コンテナに割り当てる資源。既定は NAS の実機（N100 / 4 コア）向け。
# 手元で試すときは下げる。
CPUS=3.0
MEM_LIMIT=2500m

# 同時に走らせる CLI の数。1 プロセスあたり 300〜500MB 使うので、
# 同居コンテナが増えたら減らす。
# MAX_CONCURRENT=3

# 公開先。既定はループバックだけで、前段に Tailscale を置く前提。
# LAN からも直接見せたいときだけ 0.0.0.0 にする。
# BIND_ADDR=127.0.0.1

# Android シェル（Capacitor）が開く先。Tailscale の https URL（末尾スラッシュなし）。
# `npm run android:sync` のときだけ使う。APK に焼かれるので家庭の URL を書く。
# CAPACITOR_SERVER_URL=https://kokuboke.tailXXXX.ts.net

# Android へ返答完了の push を飛ばすとき。Firebase のサービスアカウント JSON。
# 中身をそのまま書くか、ファイルの場所を書く。どちらも空ならトークンは受けるだけで飛ばさない。
# private_key の改行は \n のまま。
# FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}
# FCM_SERVICE_ACCOUNT_PATH=/data/fcm-service-account.json
