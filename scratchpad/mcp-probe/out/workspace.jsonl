{"type":"tool_call","subtype":"completed","call_id":"tool_cdb08c77-a649-4c51-a67e-5af2c8d20ad","tool_call":{"readToolCall":{"args":{"path":"/Users/yusuke/work/kokuboke/scratchpad/mcp-probe/dump.mjs"},"result":{"success":{"content":"#!/usr/bin/env node\n/**\n * 捨て MCP。cwd / env / 最初の stdin をファイルへ吐く。\n * cursor が行区切りか Content-Length かも生バイトで残す。\n */\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport readline from 'node:readline'\n\nconst dumpPath = process.env.MCP_DUMP_PATH || path.join(import.meta.dirname, 'dump.json')\n\nfunction snapshot() {\n  const keys = Object.keys(process.env)\n    .filter((k) => k.startsWith('KOKUBOKE_') || k.startsWith('MCP_') || k === 'HOME' || k === 'PWD')\n    .sort()\n  const env = {}\n  for (const k of keys) env[k] = process.env[k]\n  return {\n    cwd: process.cwd(),\n    argv: process.argv,\n    env,\n    pid: process.pid,\n    ppid: process.ppid,\n  }\n}\n\nfunction writeDump(extra) {\n  const body = { at: new Date().toISOString(), ...snapshot(), ...extra }\n  fs.mkdirSync(path.dirname(dumpPath), { recursive: true })\n  fs.writeFileSync(dumpPath, `${JSON.stringify(body, null, 2)}\\n`)\n}\n\nwriteDump({ phase: 'boot' })\n\nfunction reply(id, result) {\n  process.stdout.write(`${JSON.stringify({ jsonrpc: '2.0', id, result })}\\n`)\n}\n\nfunction handle(msg) {\n  writeDump({ phase: 'message', method: msg.method, id: msg.id, params: msg.params })\n  if (msg.method === 'initialize') {\n    reply(msg.id, {\n      protocolVersion: msg.params?.protocolVersion ?? '2024-11-05',\n      capabilities: { tools: {} },\n      serverInfo: { name: 'kokuboke-dump', version: '0.0.1' },\n    })\n    return\n  }\n  if (msg.method === 'notifications/initialized') return\n  if (msg.method === 'tools/list') {\n    reply(msg.id, {\n      tools: [\n        {\n          name: 'dump',\n          description: 'Probe helper. Call once and return.',\n          inputSchema: { type: 'object', properties: {} },\n        },\n      ],\n    })\n    return\n  }\n  if (msg.method === 'tools/call') {\n    const snap = snapshot()\n    reply(msg.id, {\n      content: [{ type: 'text', text: JSON.stringify(snap) }],\n    })\n    return\n  }\n  if (msg.id !== undefined) {\n    process.stdout.write(\n      `${JSON.stringify({ jsonrpc: '2.0', id: msg.id, error: { code: -32601, message: 'unknown' } })}\\n`,\n    )\n  }\n}\n\nconst rawChunks = []\nprocess.stdin.on('data', (buf) => {\n  if (rawChunks.length < 8) {\n    rawChunks.push(buf.toString('utf8'))\n    writeDump({ phase: 'raw', raw: rawChunks.join('').slice(0, 2000) })\n  }\n})\n\nconst rl = readline.createInterface({ input: process.stdin })\nrl.on('line', (line) => {\n  const trimmed = line.trim()\n  if (!trimmed || trimmed.startsWith('Content-Length') || trimmed.startsWith('Content-Type')) return\n  try {\n    handle(JSON.parse(trimmed))\n  } catch (error) {\n    writeDump({ phase: 'parse-error', line: trimmed, error: String(error) })\n  }\n})\n","isEmpty":false,"exceededLimit":false,"totalLines":94,"fileSize":2686,"path":"/Users/yusuke/work/kokuboke/scratchpad/mcp-probe/dump.mjs","readRange":{"startLine":1,"endLine":94},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"tool_cdb08c77-a649-4c51-a67e-5af2c8d20ad","startedAtMs":"1788059838719","completedAtMs":"1788059838839"},"model_call_id":"cbbb2ef7-0f4a-47d8-863c-3734f1d0aaca-3-oxx1","session_id":"0977ae60-0869-4a8b-970b-4a503a4305e8","timestamp_ms":1788059838849}
