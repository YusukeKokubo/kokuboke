{
  "name": "kokuboke",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "test": "tsx --test \"server/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "android:sync": "node scripts/cap-sync.mjs",
    "android:sdk": "node scripts/android-sdk.mjs",
    "android:apk": "node scripts/android-apk.mjs",
    "android:open": "npx cap open android"
  },
  "//": "dependencies はサーバーが実行時に require するものだけ。画面側の依存は vite が dist に畳み込むため devDependencies に置く（本番イメージに入れない）",
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "heic-convert": "^2.1.0",
    "hono": "^4.6.14",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/heic-convert": "^1.2.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.2",
    "katex": "^0.18.2",
    "lucide-react": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
